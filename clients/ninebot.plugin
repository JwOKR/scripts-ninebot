#!name=九号出行签到
#!desc=自动签到领 N 币 · Token 拦截抓取 · 多账号 · 失败重试
#!author=凉心 / 蛋卷
#!homepage=https://github.com/JwOKR/scripts-ninebot

[Script]
http-request ^https?://cn-cbu-gateway\.ninebot\.com/.*user-sign script-path=https://raw.githubusercontent.com/JwOKR/scripts-ninebot/main/ninebot-sign.js, requires-body=false, timeout=30, tag=九号出行抓Token
cron "5 12 * * *" script-path=https://raw.githubusercontent.com/JwOKR/scripts-ninebot/main/ninebot-sign.js, timeout=60, tag=九号出行签到, enabled=true

[MITM]
hostname = %APPEND% cn-cbu-gateway.ninebot.com
