#!name=九号出行签到
#!desc=自动签到领 N 币 · Token 拦截抓取 · 多账号 · 失败重试
#!author=凉心 / 蛋卷
#!homepage=https://github.com/JwOKR/scripts-ninebot

[Script]
# 抓 Token：拦截 user-sign 请求，只取请求头，不需要 body
九号出行抓Token = type=http-request,pattern=^https?://cn-cbu-gateway\.ninebot\.com/.*user-sign,script-path=https://raw.githubusercontent.com/JwOKR/scripts-ninebot/main/ninebot-sign.js,requires-body=false,timeout=30

# 每天 8:05 自动签到；参数可改 LogLevel / Retry / Interval / ShowDeviceId
九号出行签到 = type=cron,cronexp="5 8 * * *",script-path=https://raw.githubusercontent.com/JwOKR/scripts-ninebot/main/ninebot-sign.js,timeout=60,wake-system=true,argument="LogLevel=info&Retry=2&Interval=800"

[MITM]
hostname = cn-cbu-gateway.ninebot.com
